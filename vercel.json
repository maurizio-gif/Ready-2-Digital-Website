{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/Ready-2-Digital-Website",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Ready-2-Digital-Website/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/it/progetti/athlon-club",
      "destination": "/progetti/athlon",
      "permanent": true
    },
    {
      "source": "/en/work/athlon-club",
      "destination": "/en/work/athlon",
      "permanent": true
    },
    {
      "source": "/it/progetti/tennis-club-ambrosiano",
      "destination": "/progetti/tennis-club-ambrosiano",
      "permanent": true
    },
    {
      "source": "/it/progetti/ronchiverdi",
      "destination": "/progetti/ronchiverdi",
      "permanent": true
    },
    {
      "source": "/it/progetti/passion-fitness",
      "destination": "/progetti/passion-fitness",
      "permanent": true
    },
    {
      "source": "/it/soluzioni",
      "destination": "/soluzioni",
      "permanent": true
    },
    {
      "source": "/it/progetti",
      "destination": "/progetti",
      "permanent": true
    },
    {
      "source": "/it/metodo",
      "destination": "/metodo",
      "permanent": true
    },
    {
      "source": "/it/tecnologia",
      "destination": "/tecnologia",
      "permanent": true
    },
    {
      "source": "/it/chi-siamo",
      "destination": "/chi-siamo",
      "permanent": true
    },
    {
      "source": "/it/contatti",
      "destination": "/contatti",
      "permanent": true
    },
    {
      "source": "/casi/:slug",
      "destination": "/progetti/:slug",
      "permanent": true
    },
    {
      "source": "/en/cookie-policy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/it/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/it/cookie-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/soluzioni",
      "destination": "/index.html"
    },
    {
      "source": "/progetti",
      "destination": "/index.html"
    },
    {
      "source": "/progetti/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/metodo",
      "destination": "/index.html"
    },
    {
      "source": "/tecnologia",
      "destination": "/index.html"
    },
    {
      "source": "/chi-siamo",
      "destination": "/index.html"
    },
    {
      "source": "/contatti",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/solutions",
      "destination": "/index.html"
    },
    {
      "source": "/en/work",
      "destination": "/index.html"
    },
    {
      "source": "/en/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/en/method",
      "destination": "/index.html"
    },
    {
      "source": "/en/technology",
      "destination": "/index.html"
    },
    {
      "source": "/en/about",
      "destination": "/index.html"
    },
    {
      "source": "/en/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/index.html"
    }
  ]
}
