{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/Ready-2-Digital-Website",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Ready-2-Digital-Website/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/it/progetti/athlon-club",
      "destination": "/progetti/athlon",
      "permanent": true
    },
    {
      "source": "/en/work/athlon-club",
      "destination": "/en/work/athlon",
      "permanent": true
    },
    {
      "source": "/it/progetti/tennis-club-ambrosiano",
      "destination": "/progetti/tennis-club-ambrosiano",
      "permanent": true
    },
    {
      "source": "/it/progetti/ronchiverdi",
      "destination": "/progetti/ronchiverdi",
      "permanent": true
    },
    {
      "source": "/it/progetti/passion-fitness",
      "destination": "/progetti/passion-fitness",
      "permanent": true
    },
    {
      "source": "/it/soluzioni",
      "destination": "/soluzioni",
      "permanent": true
    },
    {
      "source": "/it/progetti",
      "destination": "/progetti",
      "permanent": true
    },
    {
      "source": "/it/metodo",
      "destination": "/metodo",
      "permanent": true
    },
    {
      "source": "/it/tecnologia",
      "destination": "/tecnologia",
      "permanent": true
    },
    {
      "source": "/it/chi-siamo",
      "destination": "/chi-siamo",
      "permanent": true
    },
    {
      "source": "/it/contatti",
      "destination": "/contatti",
      "permanent": true
    },
    {
      "source": "/casi/:slug",
      "destination": "/progetti/:slug",
      "permanent": true
    },
    {
      "source": "/en/cookie-policy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/it/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/it/cookie-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/siti-web{/}?",
      "destination": "/soluzioni#siti",
      "statusCode": 301
    },
    {
      "source": "/gestione-hardware{/}?",
      "destination": "/soluzioni#totem",
      "statusCode": 301
    },
    {
      "source": "/gestione-adv{/}?",
      "destination": "/soluzioni",
      "statusCode": 301
    },
    {
      "source": "/automazione-digitale{/}?",
      "destination": "/agenti-ai",
      "statusCode": 301
    },
    {
      "source": "/strategia{/}?",
      "destination": "/metodo",
      "statusCode": 301
    },
    {
      "source": "/glofox{/}?",
      "destination": "/chi-siamo",
      "statusCode": 301
    },
    {
      "source": "/glofox-demo{/}?",
      "destination": "/chi-siamo",
      "statusCode": 301
    },
    {
      "source": "/ready-2-digital-porta-glofox-in-italia{/}?",
      "destination": "/chi-siamo",
      "statusCode": 301
    },
    {
      "source": "/report-athlon-performance-commerciale{/}?",
      "destination": "/progetti/athlon",
      "statusCode": 301
    },
    {
      "source": "/thank-you{/}?",
      "destination": "/contatti",
      "statusCode": 301
    },
    {
      "source": "/blog{/}?",
      "destination": "/progetti",
      "statusCode": 301
    },
    {
      "source": "/test{/}?",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/sample-home-page{/}?",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/category/:path*{/}?",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/tag/:path*{/}?",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/author/:path*{/}?",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/websites-2{/}?",
      "destination": "/en/solutions#siti",
      "statusCode": 301
    },
    {
      "source": "/en/hardware-manage{/}?",
      "destination": "/en/solutions#totem",
      "statusCode": 301
    },
    {
      "source": "/en/advertising-management-2{/}?",
      "destination": "/en/solutions",
      "statusCode": 301
    },
    {
      "source": "/en/digital-automation-2{/}?",
      "destination": "/en/ai-agents",
      "statusCode": 301
    },
    {
      "source": "/en/digital-strategy{/}?",
      "destination": "/en/method",
      "statusCode": 301
    },
    {
      "source": "/en/home-english{/}?",
      "destination": "/en",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
