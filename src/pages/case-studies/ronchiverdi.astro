---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { withBase } from '../../utils/url';

const built = [
  {
    title: 'Audit dei processi',
    desc: 'Prima di una riga di codice: comunicazioni, WhatsApp, gestione dei crediti, rinnovi, reclami. Mappati come funzionavano davvero, non come si supponeva funzionassero.',
  },
  {
    title: 'Sito pubblico',
    desc: 'Lead capture e prenotazione appuntamenti, con promemoria automatico prima dell\'incontro — nessuno dimentica più un appuntamento perché nessuno se lo ricorda a mano.',
  },
  {
    title: 'CRM interno',
    desc: 'Pipeline commerciale sui lead che arrivano dal sito, timbratura e permessi per operatore, notifiche push e un avviso sonoro in tempo reale quando arriva un\'opportunità non ancora assegnata a nessuno.',
  },
];
---

<BaseLayout
  title="Case study: Ronchiverdi"
  description="Come lavoriamo prima di scrivere codice: l'audit dei processi di Ronchiverdi, poi il sito e il CRM costruiti su quello che abbiamo trovato davvero."
>

  <section class="case-hero" style="background: var(--color-dark);">
    <div class="container case-hero__content" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Circolo sportivo</span>
      <h1 class="case-hero__title" data-animate="clip-up">Ronchiverdi</h1>
      <p class="case-hero__sub" data-animate="fade-up">
        Il caso in cui si vede meglio il metodo: prima l'audit, poi il software.
        Non il contrario.
      </p>
      <div class="case-hero__tags" data-animate="fade-up">
        <TagList tags={['Astro', 'TinaCMS', 'Next.js', 'Supabase', 'Web Push']} />
      </div>
    </div>
  </section>

  <section class="section case-section">
    <div class="container case-grid">
      <div class="case-col">
        <span class="eyebrow">La sfida</span>
        <p class="case-lead">
          Nessun sistema esisteva ancora: le comunicazioni passavano per WhatsApp
          e telefonate, i crediti e i rinnovi si seguivano a memoria, i reclami
          non lasciavano traccia da nessuna parte. Costruire subito un CRM sarebbe
          stato costruire sul niente.
        </p>
      </div>
      <div class="case-col">
        <span class="eyebrow">Il metodo</span>
        <p class="case-lead">
          Prima un audit vero: come arrivano le richieste, chi le lavora, dove si
          perdono, quali reclami tornano sempre uguali. Il software che ne è nato
          — sito e CRM — segue quella mappa, non un modello standard di "CRM per
          circoli sportivi".
        </p>
      </div>
    </div>
  </section>

  <section class="section built-section" style="background: var(--color-light);">
    <div class="container">
      <span class="eyebrow reveal">Cosa abbiamo costruito</span>
      <div class="built-list" data-stagger="100">
        {built.map((b, i) => (
          <div class="built-item reveal">
            <span class="built-item__index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="built-item__title">{b.title}</h3>
              <p class="built-item__desc">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section method-note">
    <div class="container">
      <div class="method-note__inner reveal">
        <span class="eyebrow">Perché non ci sono numeri qui</span>
        <p>
          Questo progetto è più recente degli altri due: non abbiamo ancora un
          periodo di dati sufficiente per pubblicare una metrica che significhi
          qualcosa. Preferiamo scriverlo, invece di stimarlo.
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-block" style="background: var(--color-dark);">
    <div class="container cta-block__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Il prossimo caso</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">
        Potrebbe essere<br>il tuo processo.
      </h2>
      <div class="cta-block__ctas" data-animate="fade-up">
        <a href={withBase('/contatti')} class="btn btn-primary">Parliamo del tuo progetto</a>
        <a href={withBase('/case-studies')} class="link-arrow" style="color: rgba(255,255,255,0.7);">← Altri case study</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
    color: var(--color-white);
  }

  .case-hero__content { max-width: 720px; }

  .case-hero__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-white);
    margin-top: var(--space-4);
  }

  .case-hero__sub {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    color: rgba(255,255,255,0.72);
    max-width: 560px;
    line-height: 1.6;
  }

  .case-hero__tags {
    margin-top: var(--space-8);
    color: rgba(255,255,255,0.6);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }

  .case-lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-gray-mid);
    line-height: 1.7;
  }

  .built-list {
    margin-top: var(--space-10);
    display: flex;
    flex-direction: column;
  }

  .built-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-gray-light);
  }

  .built-list .built-item:last-child {
    border-bottom: 1px solid var(--color-gray-light);
  }

  .built-item__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-orange);
  }

  .built-item__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: var(--space-2);
  }

  .built-item__desc {
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    line-height: 1.65;
    max-width: 640px;
  }

  .method-note__inner {
    max-width: 640px;
    padding: var(--space-8);
    border-left: 2px solid var(--color-orange);
  }

  .method-note__inner p {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    line-height: 1.65;
  }

  .cta-block__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-block__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .case-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  @media (max-width: 640px) {
    .built-item { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
