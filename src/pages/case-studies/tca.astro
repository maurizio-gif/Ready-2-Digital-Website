---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatReadout from '../../components/StatReadout.astro';
import TagList from '../../components/TagList.astro';
import { withBase } from '../../utils/url';

const built = [
  {
    title: 'Sito pubblico',
    desc: 'Vetrina del circolo, iscrizioni a scuola tennis e summer camp, newsletter — pensato per restare statico e veloce anche senza un backend dietro ogni pagina.',
  },
  {
    title: 'CRM di segreteria',
    desc: 'Le richieste che arrivano dal sito finiscono in una pipeline unica (nuovo → in gestione → vinto/perso), con storico dei passaggi e permessi diversi per ruolo.',
  },
  {
    title: 'Anagrafica unificata',
    desc: "Una persona che scrive due volte, da due canali diversi, resta una persona sola: la deduplica gira sul database, non su un foglio che qualcuno deve ricontrollare.",
  },
  {
    title: 'Agenda condivisa',
    desc: 'Gli appuntamenti prenotati dal sito e i task interni della segreteria vivono nello stesso calendario, non in due sistemi che qualcuno deve incrociare a mano.',
  },
];
---

<BaseLayout
  title="Case study: Tennis Club Ambrosiano"
  description="Come abbiamo digitalizzato la segreteria del Tennis Club Ambrosiano: CRM, anagrafica unificata, agenda condivisa con il sito pubblico."
>

  <section class="case-hero" style="background: var(--color-dark);">
    <div class="container case-hero__content" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Circolo sportivo</span>
      <h1 class="case-hero__title" data-animate="clip-up">Tennis Club<br>Ambrosiano</h1>
      <p class="case-hero__sub" data-animate="fade-up">
        Iscrizioni, scuola tennis, summer camp, eventi: una segreteria che lavorava
        su strumenti scollegati, con un'anagrafica che si duplicava a ogni form.
      </p>
      <div class="case-hero__tags" data-animate="fade-up">
        <TagList tags={['Astro', 'TinaCMS', 'Next.js', 'Supabase', 'PerfectGym API']} />
      </div>
    </div>
  </section>

  <section class="section case-section">
    <div class="container case-grid">
      <div class="case-col">
        <span class="eyebrow">La sfida</span>
        <p class="case-lead">
          Il sito era separato dalla segreteria: i form di iscrizione arrivavano
          via email, la stessa persona poteva comparire più volte con dati diversi,
          e lo storico degli eventi del gestionale precedente non era mai stato
          portato dentro il nuovo sistema.
        </p>
      </div>
      <div class="case-col">
        <span class="eyebrow">La soluzione</span>
        <p class="case-lead">
          Un sito statico veloce e un CRM separato che condividono lo stesso
          database: il sito resta semplice da mantenere, la segreteria lavora su
          un'anagrafica sola, con lo storico importato e deduplicato, non ricostruito
          a mano.
        </p>
      </div>
    </div>
  </section>

  <section class="section built-section" style="background: var(--color-light);">
    <div class="container">
      <span class="eyebrow reveal">Cosa abbiamo costruito</span>
      <div class="built-list" data-stagger="100">
        {built.map((b, i) => (
          <div class="built-item reveal">
            <span class="built-item__index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="built-item__title">{b.title}</h3>
              <p class="built-item__desc">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section stats-section">
    <div class="container">
      <span class="eyebrow reveal">I numeri della migrazione</span>
      <div class="stat-grid" data-stagger="130">
        <StatReadout value="353" label="Eventi storici importati" note="Dal gestionale precedente" />
        <StatReadout value="220" label="Anagrafiche unificate" note="Backfill sulle persone esistenti" />
        <StatReadout value="192" label="Form deduplicati" note="Stessa persona, richieste diverse" />
      </div>
    </div>
  </section>

  <section class="section cta-block" style="background: var(--color-dark);">
    <div class="container cta-block__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Il prossimo caso</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">
        Potrebbe essere<br>il tuo processo.
      </h2>
      <div class="cta-block__ctas" data-animate="fade-up">
        <a href={withBase('/contatti')} class="btn btn-primary">Parliamo del tuo progetto</a>
        <a href={withBase('/case-studies')} class="link-arrow" style="color: rgba(255,255,255,0.7);">← Altri case study</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
    color: var(--color-white);
  }

  .case-hero__content { max-width: 720px; }

  .case-hero__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-white);
    margin-top: var(--space-4);
  }

  .case-hero__sub {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    color: rgba(255,255,255,0.72);
    max-width: 560px;
    line-height: 1.6;
  }

  .case-hero__tags {
    margin-top: var(--space-8);
    color: rgba(255,255,255,0.6);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }

  .case-lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-gray-mid);
    line-height: 1.7;
  }

  .built-list {
    margin-top: var(--space-10);
    display: flex;
    flex-direction: column;
  }

  .built-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-gray-light);
  }

  .built-list .built-item:last-child {
    border-bottom: 1px solid var(--color-gray-light);
  }

  .built-item__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-orange);
  }

  .built-item__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: var(--space-2);
  }

  .built-item__desc {
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    line-height: 1.65;
    max-width: 640px;
  }

  .stat-grid {
    margin-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .cta-block__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-block__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .case-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  @media (max-width: 640px) {
    .built-item { grid-template-columns: 1fr; gap: var(--space-2); }
    .stat-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
