---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowCanvas from '../components/FlowCanvas.astro';
import StatReadout from '../components/StatReadout.astro';
import ProcessStep from '../components/ProcessStep.astro';
import SolutionRow from '../components/SolutionRow.astro';
import { withBase } from '../utils/url';

const services = [
  {
    index: '01',
    title: 'Audit e Process Architecture',
    description: "Il punto di partenza di ogni progetto. Mappiamo i processi, identifichiamo i gap, definiamo l'architettura target.",
    href: '/servizi/audit',
  },
  {
    index: '02',
    title: 'Web & App Custom',
    description: 'Siti e applicazioni che risolvono problemi reali, integrate nel tuo stack tecnologico esistente.',
    href: '/servizi/web-app',
  },
  {
    index: '03',
    title: 'Piattaforme di Vendita Servizi',
    description: 'Prenotazioni, abbonamenti, pagamenti ricorrenti. Piattaforme native per vendere servizi online.',
    href: '/servizi/ecommerce',
  },
  {
    index: '04',
    title: 'CRM Custom',
    description: 'Un CRM che il tuo team usa davvero, perché è disegnato attorno ai tuoi processi reali.',
    href: '/servizi/crm',
  },
  {
    index: '05',
    title: 'AI & Automazione',
    description: 'AI dove crea valore reale. Automazione dei workflow, agenti che qualificano i lead, integrazione di modelli.',
    href: '/servizi/ai-automazione',
  },
  {
    index: '06',
    title: 'Software Gestionali',
    description: 'Selezione rigorosa e integrazione dei software gestionali giusti per te — o un sostituto custom, quando conviene.',
    href: '/servizi/software-gestionali',
  },
  {
    index: '07',
    title: 'Hardware & Soluzioni Immersive',
    description: 'Totem di check-in, schermi con il palinsesto, chioschi self-service. Il software vive anche fuori dallo schermo.',
    href: '/servizi/hardware',
  },
];
---

<BaseLayout
  title="Architetti dei Processi Digitali"
  description="Ready2Digital non è un'agenzia di marketing. Costruiamo il software che fa funzionare un'azienda ogni giorno — sito, CRM, automazioni, agenti AI — a partire dall'audit dei processi reali."
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero__canvas" aria-hidden="true">
      <FlowCanvas align="xMaxYMid slice" />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="container hero__content">
      <span class="eyebrow hero__eyebrow" data-animate="fade-up" data-delay="0">architettura-processi-digitali</span>
      <h1 class="hero__headline reveal-lines">
        <span class="line"><span style="--reveal-delay: 100ms">Non siamo</span></span>
        <span class="line"><span style="--reveal-delay: 220ms">un'agenzia</span></span>
        <span class="line"><span class="hero__headline-accent" style="--reveal-delay: 340ms">di marketing.</span></span>
      </h1>
      <p class="hero__sub" data-animate="fade-up" data-delay="520">
        Costruiamo il software che fa funzionare un'azienda ogni giorno: il sito
        che genera il contatto, il CRM che lo lavora, l'automazione che lo smista,
        l'agente AI che gli risponde prima del concorrente.
      </p>
      <div class="hero__ctas" data-animate="fade-up" data-delay="660">
        <a href={withBase('/contatti')} class="btn btn-primary">Parliamo del tuo processo</a>
        <a href="#risultati" class="hero__link-secondary">Vedi i risultati →</a>
      </div>
    </div>
    <div class="hero__scroll-hint" aria-hidden="true" data-animate="fade-up" data-delay="900">
      <span>Scroll</span>
      <span class="hero__scroll-line"></span>
    </div>
  </section>

  <!-- TECH MARQUEE -->
  <section class="tech-band" aria-label="Tecnologie e competenze">
    <div class="marquee">
      <div class="marquee__track">
        {[0, 1].map(() => (
          <ul class="tech-band__list" aria-hidden="false">
            <li>Audit &amp; Process Architecture</li>
            <li class="tech-band__dot">◆</li>
            <li>CRM Custom</li>
            <li class="tech-band__dot">◆</li>
            <li>AI &amp; Automazione</li>
            <li class="tech-band__dot">◆</li>
            <li>Stripe</li>
            <li class="tech-band__dot">◆</li>
            <li>GoCardless</li>
            <li class="tech-band__dot">◆</li>
            <li>n8n Workflow</li>
            <li class="tech-band__dot">◆</li>
            <li>Web &amp; App Custom</li>
            <li class="tech-band__dot">◆</li>
            <li>PWA</li>
            <li class="tech-band__dot">◆</li>
            <li>Totem &amp; POS</li>
            <li class="tech-band__dot">◆</li>
            <li>Software Gestionali</li>
            <li class="tech-band__dot">◆</li>
            <li>Dati Centralizzati</li>
            <li class="tech-band__dot">◆</li>
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- COSA NON SIAMO -->
  <section class="section differentiator">
    <div class="container">
      <div class="diff__grid" data-stagger="160">
        <div class="diff__col diff__col--no reveal">
          <div class="diff__header">
            <span>Quello che NON facciamo</span>
          </div>
          <ul class="diff__list">
            <li>Non facciamo campagne pubblicitarie</li>
            <li>Non vendiamo social media management</li>
            <li>Non implementiamo software senza capire i tuoi processi</li>
          </ul>
        </div>
        <div class="diff__divider" aria-hidden="true"></div>
        <div class="diff__col diff__col--yes reveal">
          <div class="diff__header">
            <span>Quello che facciamo</span>
          </div>
          <ul class="diff__list">
            <li>Partiamo sempre dall'audit</li>
            <li>Disegniamo l'architettura prima degli strumenti</li>
            <li>Misuriamo i risultati in modo concreto</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- RISULTATI -->
  <section class="section risultati" id="risultati">
    <div class="container">
      <div class="risultati__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Prova concreta</span>
        <h2 class="section-title" data-animate="clip-up">Un caso reale.<br>Numeri reali.</h2>
        <p class="section-subtitle" data-animate="fade-up" style="margin-top: 1.5rem;">
          Athlon Club 4.0, Roma. Da gestione operativa frammentata a digitalizzazione
          completa dei processi: sito con assistente AI, CRM interno, automazioni,
          sincronizzazione col gestionale, totem di check-in in sede.
        </p>
      </div>
      <div class="stat-grid" data-stagger="140">
        <StatReadout value="570" label="Lead unici al mese" note="Sito + assistente AI" />
        <StatReadout value="2.281" label="Lead in 4 mesi" note="Da campagna a contatto qualificato" />
        <StatReadout value="400" label="Nuovi contratti" note="Nello stesso periodo" />
        <StatReadout value="100%" label="Iscrizione digitale" note="Firma compresa, zero carta" />
      </div>
      <div class="risultati__cta reveal">
        <a href={withBase('/case-studies/athlon')} class="link-arrow">Leggi il case study completo →</a>
        <a href={withBase('/case-studies')} class="risultati__cta-secondary">Guarda tutti i case study</a>
      </div>
    </div>
  </section>

  <!-- METODO -->
  <section class="section metodo" style="background: var(--color-light);">
    <div class="container">
      <div class="metodo__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Il nostro processo</span>
        <h2 class="section-title" data-animate="clip-up">Il nostro metodo</h2>
      </div>
      <div class="process-grid" data-stagger="130">
        <ProcessStep
          number="01"
          title="Audit"
          description="Analizziamo la tua architettura attuale, i processi, i sistemi, le inefficienze"
        />
        <ProcessStep
          number="02"
          title="Gap Analysis"
          description="Identifichiamo la distanza tra dove sei e dove vuoi essere"
        />
        <ProcessStep
          number="03"
          title="Soluzione"
          description="Progettiamo la risposta tecnologica su misura per il tuo contesto"
        />
        <ProcessStep
          number="04"
          title="Implementazione"
          description="Costruiamo e integriamo. Misuriamo i risultati."
          isLast
        />
      </div>
    </div>
  </section>

  <!-- SERVIZI -->
  <section class="section servizi-preview">
    <div class="container">
      <div class="servizi-preview__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Soluzioni</span>
        <h2 class="section-title" data-animate="clip-up">Le nostre soluzioni</h2>
      </div>
      <div class="solutions-list" data-stagger="70">
        {services.map(s => (
          <SolutionRow {...s} />
        ))}
      </div>
    </div>
  </section>

  <!-- SETTORE -->
  <section class="section settore">
    <div class="container">
      <div class="settore__inner">
        <div class="settore__decoration" aria-hidden="true" data-animate="zoom-in">
          <FlowCanvas hideLabels showLoop={false} />
        </div>
        <div class="settore__content" data-stagger="120">
          <span class="eyebrow" data-animate="fade-up">Specializzazione verticale</span>
          <h2 class="section-title settore__title" data-animate="clip-up">Specializziamo in<br>Fitness & Sport</h2>
          <div class="divider" data-animate="fade-right"></div>
          <p data-animate="fade-up">
            Conosciamo dall'interno le sfide operative di un club, di una palestra,
            di un centro sportivo. Non come consulenti esterni, ma come imprenditori
            che hanno vissuto le stesse criticità. Questo ci permette di proporre
            soluzioni che funzionano davvero — e lo stesso metodo si estende a
            qualsiasi azienda con processi reali da digitalizzare.
          </p>
          <a href={withBase('/chi-siamo')} class="link-arrow" data-animate="fade-up" style="margin-top: var(--space-6);">
            La nostra storia →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO / INSIGHTS -->
  <section class="section cta-section" style="background: var(--color-dark);">
    <div class="container cta-section__inner" data-stagger="120">
      <span class="eyebrow cta-section__eyebrow" data-animate="fade-up">Il nostro punto di vista</span>
      <h2 class="section-title cta-section__title" data-animate="clip-up">
        Digitalizzazione è strategia,<br>non tecnologia.
      </h2>
      <p class="cta-section__sub" data-animate="fade-up">
        Come pensiamo i processi, l'architettura e la tecnologia.
        Idee dal campo, non dalla teoria.
      </p>
      <a href={withBase('/insights')} class="link-arrow cta-section__link" data-animate="fade-up">Leggi gli insights →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    padding-block: clamp(var(--space-20), 12vw, var(--space-32));
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.9;
  }

  /* Functional, not decorative: without this the flow diagram sits under
     the headline with too little contrast on some displays. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, var(--color-dark) 0%, var(--color-dark) 28%, rgba(26,26,26,0.55) 52%, rgba(26,26,26,0.15) 72%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hero__eyebrow {
    color: var(--color-orange);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(var(--text-5xl), 9vw, var(--text-7xl));
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: var(--space-4);
    color: var(--color-white);
  }

  .hero__headline-accent {
    color: var(--color-orange);
  }

  .hero__sub {
    margin-top: var(--space-8);
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 560px;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-10);
    flex-wrap: wrap;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    z-index: 1;
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(255,96,0,0.8), transparent);
    animation: scroll-hint 2s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes scroll-hint {
    0%   { transform: scaleY(0); opacity: 0; }
    40%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(40px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line { animation: none; }
  }

  @media (max-width: 768px) {
    .hero__scroll-hint { display: none; }
    .hero__canvas { opacity: 0.4; }
    .hero__scrim { background: linear-gradient(180deg, var(--color-dark) 55%, rgba(26,26,26,0.4) 100%); }
  }

  .hero__link-secondary {
    font-size: var(--text-base);
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    transition: color var(--transition-fast);
  }

  .hero__link-secondary:hover {
    color: var(--color-white);
  }

  /* TECH BAND */
  .tech-band {
    background: var(--color-dark);
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-block: var(--space-5);
  }

  .tech-band__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-right: var(--space-8);
    white-space: nowrap;
  }

  .tech-band__list li {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
  }

  .tech-band__dot {
    color: var(--color-orange) !important;
    font-size: var(--text-xs) !important;
  }

  /* DIFFERENTIATOR — a spec-sheet comparison, not a bordered card */
  .differentiator {
    background: var(--color-white);
  }

  .diff__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-10);
    /* default (stretch) align-items so the divider's height: 100% below
       actually spans the row — the text columns still read from the top
       since their own content is block-flow, unaffected by the stretch. */
  }

  .diff__divider {
    width: 1px;
    height: 100%;
    background: var(--color-gray-light);
  }

  .diff__header {
    font-family: var(--font-mono);
    margin-bottom: var(--space-6);
    font-weight: 500;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-mid);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-light);
  }

  .diff__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .diff__col--no .diff__list li,
  .diff__col--yes .diff__list li {
    font-size: var(--text-lg);
    padding-left: var(--space-6);
    position: relative;
  }

  .diff__col--no .diff__list li { color: var(--color-gray-mid); }
  .diff__col--no .diff__list li::before { content: '✗'; position: absolute; left: 0; top: 2px; color: var(--color-gray-mid); font-size: var(--text-sm); }

  .diff__col--yes .diff__list li { color: var(--color-dark); font-weight: 500; }
  .diff__col--yes .diff__list li::before { content: '✓'; position: absolute; left: 0; top: 2px; color: var(--color-orange); font-size: var(--text-sm); }

  /* RISULTATI */
  .risultati__intro { text-align: center; margin-bottom: var(--space-12); margin-inline: auto; max-width: 640px; }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .risultati__cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .risultati__cta-secondary {
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    text-decoration: underline;
    text-decoration-color: var(--color-gray-light);
  }

  /* METODO */
  .metodo__intro { text-align: center; margin-bottom: var(--space-12); }

  .process-grid {
    display: flex;
    gap: var(--space-4);
  }

  /* SERVIZI */
  .servizi-preview__intro { margin-bottom: var(--space-8); }

  .solutions-list {
    display: flex;
    flex-direction: column;
  }

  /* SETTORE */
  .settore {
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .settore__inner {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
  }

  .settore__decoration {
    position: absolute;
    right: -60px;
    top: -40px;
    width: 520px;
    height: 520px;
    pointer-events: none;
    opacity: 0.8;
  }

  .settore__content {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .settore__title { color: var(--color-white); margin-top: var(--space-2); }

  .settore__content p {
    color: rgba(255,255,255,0.75);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* CTA SECTION */
  .cta-section__inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-section__title { color: var(--color-white); }
  .cta-section__sub { font-size: var(--text-lg); color: rgba(255,255,255,0.7); }

  /* Responsive */
  @media (max-width: 768px) {
    .diff__grid { grid-template-columns: 1fr; gap: var(--space-10); }
    .diff__divider { display: none; }
    .stat-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-6); }
    .process-grid { flex-direction: column; }
    .settore__decoration { width: 340px; height: 340px; right: -100px; }
  }
</style>
