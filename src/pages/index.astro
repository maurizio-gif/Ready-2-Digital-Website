---
// The site has no language-neutral homepage: everything lives under /it/
// or /en/. This root is a redirect stub only, kept out of the sitemap
// (see astro.config.mjs) and marked noindex so /it/ is what gets indexed.
import { withBase } from '../utils/url';
import { routeFor } from '../i18n/routes';

const target = withBase(routeFor('home', 'it'));
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>Ready2Digital</title>
  </head>
  <body>
    <p>Reindirizzamento a <a href={target}>ready2digital.it</a>…</p>
  </body>
</html>
