---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/url';
import { routeFor } from '../../../i18n/routes';

const allWork = await getCollection('work', ({ data }) => data.locale === 'it');
const order = ['athlon', 'lume', 'tca', 'aspresso', 'ronchiverdi', 'passion-fitness', 'body-energie', 'enjoy-club'];
const work = order
  .map((id) => allWork.find((w) => w.data.caseId === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));
---

<BaseLayout
  title="Progetti — Ready2Digital"
  description="Casi reali, non promesse: ogni progetto qui sotto è in produzione, con i numeri veri dei clienti dove esistono."
  locale="it"
  path={routeFor('work', 'it')}
  alternatePath={routeFor('work', 'en')}
  breadcrumbs={[{ name: 'Home', path: routeFor('home', 'it') }, { name: 'Progetti', path: routeFor('work', 'it') }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-animate="fade-up">Progetti</span>
      <h1 class="page-hero__title" data-animate="clip-up">Casi reali, non promesse</h1>
      <p class="page-hero__sub" data-animate="fade-up">
        Ogni progetto qui sotto è in produzione. I numeri sono quelli reali dei
        clienti, non stime — e dove non ci sono ancora, lo diciamo.
      </p>
    </div>
  </section>

  <section class="section cases-section">
    <div class="container">
      <div class="cases-list" data-stagger="120">
        {work.map((w) => (
          <a href={withBase(`/it/progetti/${w.data.slug}/`)} class="case-row reveal">
            <div class="case-row__main">
              <span class="case-row__sector">{w.data.sector}</span>
              <h2 class="case-row__client">{w.data.client}</h2>
              <p class="case-row__desc">{w.data.excerpt}</p>
            </div>
            <div class="case-row__side">
              {w.data.metrics[0] && (
                <span class="case-row__result">{w.data.metrics[0].value} — {w.data.metrics[0].label}</span>
              )}
              <span class="case-row__link">Leggi il progetto →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-block" style="background: var(--color-light);">
    <div class="container cta-block__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Il prossimo progetto</span>
      <h2 class="section-title" data-animate="clip-up">Potrebbe essere il tuo processo.</h2>
      <a href={withBase('/it/contatti/')} class="btn btn-primary" data-animate="fade-up">Parliamo del tuo progetto</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(var(--space-16), 10vw, var(--space-20)); max-width: 760px; }
  .page-hero__title { font-family: var(--font-display); font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl)); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin-top: var(--space-4); }
  .page-hero__sub { margin-top: var(--space-6); font-size: var(--text-xl); color: var(--color-gray-mid); line-height: 1.6; max-width: 560px; }

  .cases-list { display: flex; flex-direction: column; }

  .case-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-10);
    align-items: center;
    padding-block: var(--space-10);
    border-top: 1px solid var(--color-gray-light);
    color: inherit;
  }
  .cases-list a:last-of-type { border-bottom: 1px solid var(--color-gray-light); }

  .case-row__sector { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-orange); }
  .case-row__client { font-family: var(--font-display); font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl)); font-weight: 700; color: var(--color-dark); margin-top: var(--space-2); }
  .case-row:hover .case-row__client { color: var(--color-orange); }
  .case-row__desc { margin-top: var(--space-3); font-size: var(--text-base); color: var(--color-gray-mid); line-height: 1.6; max-width: 520px; }

  .case-row__side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-3); text-align: right; }
  .case-row__result { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-dark); }
  .case-row__link { font-size: var(--text-sm); font-weight: 600; color: var(--color-orange); }

  .cta-block__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }

  @media (max-width: 768px) {
    .case-row { grid-template-columns: 1fr; gap: var(--space-4); }
    .case-row__side { align-items: flex-start; text-align: left; }
  }
</style>
