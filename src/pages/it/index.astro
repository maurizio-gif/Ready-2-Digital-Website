---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemsProblem from '../../components/SystemsProblem.astro';
import ProcessStep from '../../components/ProcessStep.astro';
import SolutionRow from '../../components/SolutionRow.astro';
import { withBase } from '../../utils/url';
import { routeFor } from '../../i18n/routes';

const allWork = await getCollection('work', ({ data }) => data.locale === 'it');
const order = ['athlon', 'lume', 'tca', 'aspresso', 'ronchiverdi', 'passion-fitness', 'body-energie', 'enjoy-club'];
const work = order
  .map((id) => allWork.find((w) => w.data.caseId === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));

const clients = [
  'Athlon Club',
  'Tennis Club Ambrosiano',
  'Ronchiverdi',
  'Aspresso',
  'Lume Fitness',
  'Passion Fitness',
  'Body Energie',
  'Enjoy Club',
];

const solutions = [
  { index: '01', title: 'Digital Experience', description: 'Siti e interfacce che generano contatti, qualificano lead e si collegano al resto dell\'infrastruttura.', href: '/it/soluzioni/#digital-experience' },
  { index: '02', title: 'Business Systems', description: 'CRM, gestionali custom, pipeline, agenda, permessi — costruiti attorno ai processi reali del team.', href: '/it/soluzioni/#business-systems' },
  { index: '03', title: 'Automation', description: 'Smistamento dei lead, sincronizzazione dei dati, promemoria, processi amministrativi automatizzati.', href: '/it/soluzioni/#automation' },
  { index: '04', title: 'AI', description: 'Assistenti che rispondono su una base di conoscenza verificata, classificazione, matching, passaggio a un operatore.', href: '/it/soluzioni/#ai' },
  { index: '05', title: 'Integrations', description: 'Collegamenti fra gestionali verticali, CRM, pagamenti, WhatsApp, email, sistemi legacy.', href: '/it/soluzioni/#integrations' },
  { index: '06', title: 'Physical Experience', description: 'Totem, check-in, display, palinsesti — il software vive anche fuori dallo schermo.', href: '/it/soluzioni/#physical-experience' },
];
---

<BaseLayout
  title="Ready2Digital — Sistemi digitali costruiti sui processi reali"
  description="Ready2Digital progetta sistemi digitali su misura: siti, CRM, software gestionali, automazioni, integrazioni e AI costruiti intorno ai processi reali della tua azienda."
  locale="it"
  path={routeFor('home', 'it')}
  alternatePath={routeFor('home', 'en')}
>

  <!-- HERO — typographic, no illustration -->
  <section class="hero">
    <div class="container hero__content">
      <span class="eyebrow" data-animate="fade-up">Ready2Digital</span>
      <h1 class="hero__headline reveal-lines">
        <span class="line"><span style="--reveal-delay: 80ms">La tecnologia deve</span></span>
        <span class="line"><span style="--reveal-delay: 200ms">adattarsi all'azienda.</span></span>
        <span class="line"><span class="hero__headline-accent" style="--reveal-delay: 320ms">Non il contrario.</span></span>
      </h1>
      <p class="hero__sub" data-animate="fade-up" data-delay="480">
        Progettiamo sistemi digitali su misura: siti, CRM, software gestionali,
        automazioni, integrazioni e AI costruiti intorno ai processi reali della
        tua azienda.
      </p>
      <p class="hero__note" data-animate="fade-up" data-delay="560">
        Ready2Digital nasce dall'esperienza di chi un'azienda la gestisce ogni
        giorno. Per questo partiamo dai processi, non dal software.
      </p>
      <div class="hero__ctas" data-animate="fade-up" data-delay="640">
        <a href={withBase('/it/contatti/')} class="btn btn-primary">Parliamo del tuo progetto</a>
        <a href={withBase('/it/metodo/')} class="hero__link-secondary">Scopri come lavoriamo →</a>
      </div>
    </div>
  </section>

  <!-- CLIENT PROOF -->
  <section class="proof">
    <div class="container">
      <p class="proof__caption reveal">Tecnologia che lavora già in aziende reali.</p>
      <ul class="proof__list stagger-list">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section problem">
    <div class="container">
      <div class="problem__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Il problema</span>
        <h2 class="section-title" data-animate="clip-up">
          Il problema non è avere pochi software.<br>È averne troppi che non lavorano insieme.
        </h2>
      </div>
      <div class="problem__diagram">
        <SystemsProblem
          systems={['Sito', 'CRM', 'Gestionale', 'WhatsApp', 'Pagamenti', 'Email', 'Excel', 'Team']}
          labels={{ before: 'Sistemi scollegati', middle: 'READY2DIGITAL', after: 'Operazioni connesse' }}
        />
      </div>
      <p class="problem__note reveal">
        Quando questi elementi restano scollegati, i dati si duplicano, le persone
        ricopiano informazioni a mano, i lead si perdono, il cliente deve ripetere
        le stesse cose due volte, e nessuno ha una vista completa di cosa sta
        succedendo davvero.
      </p>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section work" id="work">
    <div class="container">
      <div class="work__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Progetti</span>
        <h2 class="section-title" data-animate="clip-up">Tecnologia già in produzione</h2>
      </div>
      <div class="work__grid" data-stagger="100">
        {work.map((w, i) => (
          <a href={withBase(`/it/progetti/${w.data.slug}/`)} class:list={['work-card', 'reveal', { 'work-card--lg': i === 0, 'work-card--md': i > 0 && i < 4 }]}>
            <span class="work-card__sector">{w.data.sector}</span>
            <h3 class="work-card__client">{w.data.client}</h3>
            <p class="work-card__excerpt">{w.data.excerpt}</p>
            <span class="work-card__link">Scopri il progetto →</span>
          </a>
        ))}
      </div>
      <div class="work__cta reveal">
        <a href={withBase('/it/progetti/')} class="link-arrow">Tutti i progetti →</a>
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section class="section method" style="background: var(--color-light);">
    <div class="container">
      <div class="method__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Il metodo</span>
        <h2 class="section-title" data-animate="clip-up">
          Prima capiamo come funziona l'azienda.<br>Poi scegliamo la tecnologia.
        </h2>
      </div>
      <div class="process-grid" data-stagger="130">
        <ProcessStep number="01" title="Audit" description="Osserviamo i processi che succedono davvero ogni giorno — non quelli teorici." />
        <ProcessStep number="02" title="Gap Analysis" description="Misuriamo la distanza tra il processo attuale e quello desiderato." />
        <ProcessStep number="03" title="Build" description="Costruiamo solo ciò che serve: sito, CRM, integrazione, automazione, agente AI." />
        <ProcessStep number="04" title="Measure" description="Misuriamo l'effetto sul business. Non impressioni: metriche." isLast />
      </div>
      <div class="method__cta reveal">
        <a href={withBase('/it/metodo/')} class="link-arrow">Il metodo per intero →</a>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS PREVIEW -->
  <section class="section solutions-preview">
    <div class="container">
      <div class="solutions-preview__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Cosa costruiamo</span>
        <h2 class="section-title" data-animate="clip-up">Un sistema, non una collezione di strumenti</h2>
      </div>
      <div class="solutions-list" data-stagger="70">
        {solutions.map((s) => <SolutionRow {...s} />)}
      </div>
    </div>
  </section>

  <!-- BUILD VS BUY -->
  <section class="section build-vs-buy" style="background: var(--color-dark); color: var(--color-white);">
    <div class="container">
      <div class="bvb__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Come scegliamo</span>
        <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">Non partiamo dal software da vendere</h2>
      </div>
      <div class="bvb__grid" data-stagger="120">
        <div class="bvb__item reveal">
          <span class="bvb__label">Usiamo</span>
          <p>Software esistenti quando fanno bene il loro lavoro.</p>
        </div>
        <div class="bvb__item reveal">
          <span class="bvb__label">Integriamo</span>
          <p>Quello che già funziona, quando manca solo una connessione.</p>
        </div>
        <div class="bvb__item reveal">
          <span class="bvb__label">Costruiamo</span>
          <p>Solo quando il processo richiede qualcosa che il mercato non offre.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNOLOGY PREVIEW -->
  <section class="section tech-preview">
    <div class="container tech-preview__inner">
      <div data-stagger="120">
        <span class="eyebrow" data-animate="fade-up">Tecnologia</span>
        <h2 class="section-title" data-animate="clip-up">Scelta per il problema, non per la moda</h2>
        <p class="tech-preview__body reveal">
          Astro e Next.js per il frontend, Supabase come fonte unica dei dati, n8n
          per orchestrare le automazioni, integrazioni dirette con i gestionali di
          settore. Nessun vendor unico da cui dipendere.
        </p>
        <a href={withBase('/it/tecnologia/')} class="link-arrow reveal">Lo stack per intero →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section about-preview" style="background: var(--color-light);">
    <div class="container about-preview__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Chi siamo</span>
      <h2 class="section-title" data-animate="clip-up">Non abbiamo imparato i processi da un brief. Li abbiamo vissuti.</h2>
      <p class="reveal">
        Ready2Digital nasce dall'esperienza diretta nella gestione di Athlon Club,
        storica realtà sportiva romana. Quel metodo è oggi applicato ad altre
        aziende con processi reali da digitalizzare.
      </p>
      <a href={withBase('/it/chi-siamo/')} class="link-arrow reveal">La nostra storia →</a>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta" style="background: var(--color-dark);">
    <div class="container final-cta__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Iniziamo</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">
        Prima i processi.<br>Poi il software.
      </h2>
      <a href={withBase('/it/contatti/')} class="btn btn-primary" data-animate="fade-up">Parliamo del tuo progetto</a>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: clamp(var(--space-24), 16vw, var(--space-32));
    background: var(--color-white);
  }

  .hero__content { max-width: 900px; }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: var(--space-4);
    color: var(--color-dark);
  }

  .hero__headline-accent { color: var(--color-orange); }

  .hero__sub {
    margin-top: var(--space-8);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    color: var(--color-charcoal);
    line-height: 1.6;
    max-width: 620px;
  }

  .hero__note {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    max-width: 560px;
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-10);
    flex-wrap: wrap;
  }

  .hero__link-secondary {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* PROOF */
  .proof {
    border-top: 1px solid var(--color-gray-light);
    border-bottom: 1px solid var(--color-gray-light);
    padding-block: var(--space-10);
  }

  .proof__caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-mid);
    margin-bottom: var(--space-5);
  }

  .proof__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-10);
  }

  .proof__list li {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-charcoal);
    opacity: 0.55;
  }

  /* PROBLEM */
  .problem__intro { max-width: 760px; margin-bottom: var(--space-12); }
  .problem__diagram { margin-bottom: var(--space-10); overflow-x: auto; }
  .problem__note { max-width: 640px; font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; }

  /* WORK */
  .work__intro { margin-bottom: var(--space-10); }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-gray-light);
    grid-column: span 1;
    color: inherit;
  }

  .work-card--lg { grid-column: span 2; grid-row: span 2; padding: var(--space-8); background: var(--color-dark); color: var(--color-white); border-color: var(--color-dark); }
  .work-card--lg .work-card__sector { color: rgba(255,255,255,0.55); }
  .work-card--lg .work-card__client { color: var(--color-white); font-size: var(--text-3xl); }
  .work-card--lg .work-card__excerpt { color: rgba(255,255,255,0.75); }

  .work-card--md { grid-column: span 2; }

  .work-card__sector {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-mid);
  }

  .work-card__client {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
  }

  .work-card__excerpt {
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    line-height: 1.55;
    flex: 1;
  }

  .work-card__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-orange);
  }

  .work__cta { margin-top: var(--space-10); }

  /* METHOD */
  .method__intro { max-width: 700px; margin-bottom: var(--space-12); }
  .process-grid { display: flex; gap: var(--space-4); }
  .method__cta { margin-top: var(--space-12); }

  /* SOLUTIONS PREVIEW */
  .solutions-preview__intro { margin-bottom: var(--space-8); max-width: 700px; }
  .solutions-list { display: flex; flex-direction: column; }

  /* BUILD VS BUY */
  .bvb__intro { max-width: 700px; margin-bottom: var(--space-12); }
  .bvb__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .bvb__item { border-top: 1px solid rgba(255,255,255,0.15); padding-top: var(--space-6); }
  .bvb__label { display: block; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-orange); margin-bottom: var(--space-3); }
  .bvb__item p { font-size: var(--text-lg); color: rgba(255,255,255,0.85); line-height: 1.5; }

  /* TECH PREVIEW */
  .tech-preview__inner { max-width: 700px; }
  .tech-preview__body { margin-top: var(--space-5); font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; margin-bottom: var(--space-6); }

  /* ABOUT PREVIEW */
  .about-preview__inner { max-width: 700px; display: flex; flex-direction: column; gap: var(--space-5); }
  .about-preview__inner p { font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; }

  /* FINAL CTA */
  .final-cta__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }

  @media (max-width: 1024px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); }
    .work-card--lg { grid-column: span 2; grid-row: span 1; }
    .work-card--md { grid-column: span 1; }
    .bvb__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  @media (max-width: 640px) {
    .work__grid { grid-template-columns: 1fr; }
    .work-card--lg, .work-card--md { grid-column: span 1; }
    .process-grid { flex-direction: column; }
  }
</style>
