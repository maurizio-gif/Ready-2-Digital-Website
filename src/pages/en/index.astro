---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemsProblem from '../../components/SystemsProblem.astro';
import ProcessStep from '../../components/ProcessStep.astro';
import SolutionRow from '../../components/SolutionRow.astro';
import { withBase } from '../../utils/url';
import { routeFor } from '../../i18n/routes';

const allWork = await getCollection('work', ({ data }) => data.locale === 'en');
const order = ['athlon', 'lume', 'tca', 'aspresso', 'ronchiverdi', 'passion-fitness', 'body-energie', 'enjoy-club'];
const work = order
  .map((id) => allWork.find((w) => w.data.caseId === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));

const clients = [
  'Athlon Club',
  'Tennis Club Ambrosiano',
  'Ronchiverdi',
  'Aspresso',
  'Lume Fitness',
  'Passion Fitness',
  'Body Energie',
  'Enjoy Club',
];

const solutions = [
  { index: '01', title: 'Digital Experience', description: 'Websites and interfaces that generate contacts, qualify leads, and connect to the rest of the infrastructure.', href: '/en/solutions/#digital-experience' },
  { index: '02', title: 'Business Systems', description: 'CRM, custom management software, pipelines, calendars, permissions — built around how the team actually works.', href: '/en/solutions/#business-systems' },
  { index: '03', title: 'Automation', description: 'Lead routing, data sync, reminders, automated administrative processes.', href: '/en/solutions/#automation' },
  { index: '04', title: 'AI', description: 'Assistants that answer from a verified knowledge base, classification, matching, hand-off to a human.', href: '/en/solutions/#ai' },
  { index: '05', title: 'Integrations', description: 'Connections between vertical management software, CRM, payments, WhatsApp, email, legacy systems.', href: '/en/solutions/#integrations' },
  { index: '06', title: 'Physical Experience', description: 'Kiosks, check-in, displays, schedules — software lives outside the screen too.', href: '/en/solutions/#physical-experience' },
];
---

<BaseLayout
  title="Ready2Digital — Digital systems built around real processes"
  description="Ready2Digital designs custom digital systems: websites, CRM, operations software, automation, integrations and AI, built around how your business actually works."
  locale="en"
  path={routeFor('home', 'en')}
  alternatePath={routeFor('home', 'it')}
>

  <!-- HERO — typographic, no illustration -->
  <section class="hero">
    <div class="container hero__content">
      <span class="eyebrow" data-animate="fade-up">Ready2Digital</span>
      <h1 class="hero__headline reveal-lines">
        <span class="line"><span style="--reveal-delay: 80ms">Technology should</span></span>
        <span class="line"><span style="--reveal-delay: 200ms">fit your business.</span></span>
        <span class="line"><span class="hero__headline-accent" style="--reveal-delay: 320ms">Not the other way around.</span></span>
      </h1>
      <p class="hero__sub" data-animate="fade-up" data-delay="480">
        We design digital systems around the way your business actually works —
        from websites and CRM to operations software, automation, integrations
        and AI.
      </p>
      <p class="hero__note" data-animate="fade-up" data-delay="560">
        Ready2Digital was started by someone who runs a business every day. That's
        why we start from processes, not from software.
      </p>
      <div class="hero__ctas" data-animate="fade-up" data-delay="640">
        <a href={withBase('/en/contact/')} class="btn btn-primary">Tell us about your project</a>
        <a href={withBase('/en/method/')} class="hero__link-secondary">See how we work →</a>
      </div>
    </div>
  </section>

  <!-- CLIENT PROOF -->
  <section class="proof">
    <div class="container">
      <p class="proof__caption reveal">Technology already running real businesses.</p>
      <ul class="proof__list stagger-list">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section problem">
    <div class="container">
      <div class="problem__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">The problem</span>
        <h2 class="section-title" data-animate="clip-up">
          The problem isn't having too little software.<br>It's having systems that don't work together.
        </h2>
      </div>
      <div class="problem__diagram">
        <SystemsProblem
          systems={['Website', 'CRM', 'Management software', 'WhatsApp', 'Payments', 'Email', 'Spreadsheets', 'Team']}
          labels={{ before: 'Fragmented systems', middle: 'READY2DIGITAL', after: 'Connected operations' }}
        />
      </div>
      <p class="problem__note reveal">
        When these stay disconnected, data gets duplicated, people re-type
        information by hand, leads fall through the cracks, customers have to
        repeat themselves, and nobody has a full view of what's actually
        happening.
      </p>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section work" id="work">
    <div class="container">
      <div class="work__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">Work</span>
        <h2 class="section-title" data-animate="clip-up">Technology already in production</h2>
      </div>
      <div class="work__grid" data-stagger="100">
        {work.map((w, i) => (
          <a href={withBase(`/en/work/${w.data.slug}/`)} class:list={['work-card', 'reveal', { 'work-card--lg': i === 0, 'work-card--md': i > 0 && i < 4 }]}>
            {w.data.logo && (
              <div class="work-card__media">
                <img src={withBase(w.data.logo)} alt={w.data.client} loading="lazy" decoding="async" width="160" height="160" />
              </div>
            )}
            <div class="work-card__body">
              <span class="work-card__sector">{w.data.sector}</span>
              <h3 class="work-card__client">{w.data.client}</h3>
              <p class="work-card__excerpt">{w.data.excerpt}</p>
              <span class="work-card__link">See the project →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="work__cta reveal">
        <a href={withBase('/en/work/')} class="link-arrow">All projects →</a>
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section class="section method" style="background: var(--color-light);">
    <div class="container">
      <div class="method__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">The method</span>
        <h2 class="section-title" data-animate="clip-up">
          We first understand how the business works.<br>Then we choose the technology.
        </h2>
      </div>
      <div class="process-grid" data-stagger="130">
        <ProcessStep number="01" title="Audit" description="We observe the processes that actually happen every day — not the theoretical ones." />
        <ProcessStep number="02" title="Gap Analysis" description="We measure the distance between the current process and the desired one." />
        <ProcessStep number="03" title="Build" description="We build only what's needed: a website, a CRM, an integration, automation, an AI agent." />
        <ProcessStep number="04" title="Measure" description="We measure the effect on the business. Not impressions: metrics." isLast />
      </div>
      <div class="method__cta reveal">
        <a href={withBase('/en/method/')} class="link-arrow">The full method →</a>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS PREVIEW -->
  <section class="section solutions-preview">
    <div class="container">
      <div class="solutions-preview__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">What we build</span>
        <h2 class="section-title" data-animate="clip-up">A system, not a collection of tools</h2>
      </div>
      <div class="solutions-list" data-stagger="70">
        {solutions.map((s) => <SolutionRow {...s} />)}
      </div>
    </div>
  </section>

  <!-- BUILD VS BUY -->
  <section class="section build-vs-buy" style="background: var(--color-dark); color: var(--color-white);">
    <div class="container">
      <div class="bvb__intro" data-stagger="130">
        <span class="eyebrow" data-animate="fade-up">How we decide</span>
        <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">We don't start from the software we'd like to sell</h2>
      </div>
      <div class="bvb__grid" data-stagger="120">
        <div class="bvb__item reveal">
          <span class="bvb__label">We use</span>
          <p>Existing software when it already does its job well.</p>
        </div>
        <div class="bvb__item reveal">
          <span class="bvb__label">We integrate</span>
          <p>What already works, when it's just missing a connection.</p>
        </div>
        <div class="bvb__item reveal">
          <span class="bvb__label">We build</span>
          <p>Only when the process needs something the market doesn't offer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNOLOGY PREVIEW -->
  <section class="section tech-preview">
    <div class="container tech-preview__inner">
      <div data-stagger="120">
        <span class="eyebrow" data-animate="fade-up">Technology</span>
        <h2 class="section-title" data-animate="clip-up">Chosen for the problem, not for the trend</h2>
        <p class="tech-preview__body reveal">
          Astro and Next.js on the frontend, Supabase as the single source of data,
          n8n orchestrating automation, direct integrations with industry
          management software. No single vendor to depend on.
        </p>
        <a href={withBase('/en/technology/')} class="link-arrow reveal">The full stack →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section about-preview" style="background: var(--color-light);">
    <div class="container about-preview__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">About</span>
      <h2 class="section-title" data-animate="clip-up">We didn't learn operations from a brief. We lived them.</h2>
      <p class="reveal">
        Ready2Digital grew out of running Athlon Club, a long-standing sports
        business in Rome. That method is now applied to other businesses with
        real processes to digitise.
      </p>
      <a href={withBase('/en/about/')} class="link-arrow reveal">Our story →</a>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta" style="background: var(--color-dark);">
    <div class="container final-cta__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">Let's start</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">
        Processes first.<br>Software second.
      </h2>
      <a href={withBase('/en/contact/')} class="btn btn-primary" data-animate="fade-up">Tell us about your project</a>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: clamp(var(--space-24), 16vw, var(--space-32));
    background: var(--color-white);
  }

  .hero__content { max-width: 900px; }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: var(--space-4);
    color: var(--color-dark);
  }

  .hero__headline-accent { color: var(--color-orange); }

  .hero__sub {
    margin-top: var(--space-8);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    color: var(--color-charcoal);
    line-height: 1.6;
    max-width: 620px;
  }

  .hero__note {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    max-width: 560px;
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-10);
    flex-wrap: wrap;
  }

  .hero__link-secondary {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-charcoal);
  }

  /* PROOF */
  .proof {
    border-top: 1px solid var(--color-gray-light);
    border-bottom: 1px solid var(--color-gray-light);
    padding-block: var(--space-10);
  }

  .proof__caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-mid);
    margin-bottom: var(--space-5);
  }

  .proof__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-10);
  }

  .proof__list li {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-charcoal);
    opacity: 0.55;
  }

  /* PROBLEM */
  .problem__intro { max-width: 760px; margin-bottom: var(--space-12); }
  .problem__diagram { margin-bottom: var(--space-10); overflow-x: auto; }
  .problem__note { max-width: 640px; font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; }

  /* WORK */
  .work__intro { margin-bottom: var(--space-10); }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .work-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-gray-light);
    grid-column: span 1;
    color: inherit;
    overflow: hidden;
  }

  .work-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }
  .work-card__media img {
    max-width: min(120px, 55%);
    max-height: min(120px, 55%);
    object-fit: contain;
    display: block;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .work-card:hover .work-card__media img { transform: scale(1.08); }

  .work-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex: 1;
  }

  .work-card--lg { grid-column: span 2; grid-row: span 2; background: var(--color-dark); color: var(--color-white); border-color: var(--color-dark); }
  .work-card--lg .work-card__media { aspect-ratio: unset; flex: 1; min-height: 260px; }
  .work-card--lg .work-card__body { flex: 0 0 auto; padding: var(--space-8); }
  .work-card--lg .work-card__sector { color: rgba(255,255,255,0.55); }
  .work-card--lg .work-card__client { color: var(--color-white); font-size: var(--text-3xl); }
  .work-card--lg .work-card__excerpt { color: rgba(255,255,255,0.75); }

  .work-card--md { grid-column: span 2; }

  .work-card__sector {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-mid);
  }

  .work-card__client {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
  }

  .work-card__excerpt {
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    line-height: 1.55;
    flex: 1;
  }

  .work-card__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-orange);
  }

  .work__cta { margin-top: var(--space-10); }

  /* METHOD */
  .method__intro { max-width: 700px; margin-bottom: var(--space-12); }
  .process-grid { display: flex; gap: var(--space-4); }
  .method__cta { margin-top: var(--space-12); }

  /* SOLUTIONS PREVIEW */
  .solutions-preview__intro { margin-bottom: var(--space-8); max-width: 700px; }
  .solutions-list { display: flex; flex-direction: column; }

  /* BUILD VS BUY */
  .bvb__intro { max-width: 700px; margin-bottom: var(--space-12); }
  .bvb__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .bvb__item { border-top: 1px solid rgba(255,255,255,0.15); padding-top: var(--space-6); }
  .bvb__label { display: block; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-orange); margin-bottom: var(--space-3); }
  .bvb__item p { font-size: var(--text-lg); color: rgba(255,255,255,0.85); line-height: 1.5; }

  /* TECH PREVIEW */
  .tech-preview__inner { max-width: 700px; }
  .tech-preview__body { margin-top: var(--space-5); font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; margin-bottom: var(--space-6); }

  /* ABOUT PREVIEW */
  .about-preview__inner { max-width: 700px; display: flex; flex-direction: column; gap: var(--space-5); }
  .about-preview__inner p { font-size: var(--text-lg); color: var(--color-gray-mid); line-height: 1.7; }

  /* FINAL CTA */
  .final-cta__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }

  @media (max-width: 1024px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); }
    .work-card--lg { grid-column: span 2; grid-row: span 1; }
    .work-card--md { grid-column: span 1; }
    .bvb__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  @media (max-width: 640px) {
    .work__grid { grid-template-columns: 1fr; }
    .work-card--lg, .work-card--md { grid-column: span 1; }
    .process-grid { flex-direction: column; }
  }
</style>
