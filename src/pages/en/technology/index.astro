---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagList from '../../../components/TagList.astro';
import { withBase } from '../../../utils/url';
import { routeFor } from '../../../i18n/routes';

const stack = [
  { title: 'Public websites', tags: ['Astro', 'HTML', 'CSS', 'TinaCMS'] },
  { title: 'Applications and CRM', tags: ['Next.js', 'React', 'TypeScript'] },
  { title: 'Database and backend', tags: ['Supabase', 'PostgreSQL', 'Row Level Security'] },
  { title: 'Automation', tags: ['n8n'] },
  { title: 'Integrations', tags: ['REST APIs', 'OData', 'PerfectGym API'] },
  { title: 'Payments', tags: ['Stripe', 'GoCardless'] },
  { title: 'Communication', tags: ['WhatsApp Business', 'SendGrid', 'Web Push'] },
  { title: 'AI', tags: ['LLMs via API', 'Knowledge base', 'Retrieval', 'Conversational agents'] },
  { title: 'Infrastructure', tags: ['Vercel', 'GitHub'] },
];
---

<BaseLayout
  title="Technology — Ready2Digital"
  description="The stack we actually use: Astro and Next.js on the frontend, Supabase as the single source of data, n8n for automation. Chosen for the problem, not the trend."
  locale="en"
  path={routeFor('technology', 'en')}
  alternatePath={routeFor('technology', 'it')}
  breadcrumbs={[{ name: 'Home', path: routeFor('home', 'en') }, { name: 'Technology', path: routeFor('technology', 'en') }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-animate="fade-up">Technology</span>
      <h1 class="page-hero__title" data-animate="clip-up">Modern technology. Chosen for the problem, not the trend.</h1>
      <p class="page-hero__sub" data-animate="fade-up">
        Technology is a proof point, not a starting point. This is the stack we
        actually use on projects in production — not a list of keywords.
      </p>
    </div>
  </section>

  <section class="section stack-section">
    <div class="container">
      <div class="stack-grid" data-stagger="90">
        {stack.map((s) => (
          <div class="stack-item reveal">
            <h2 class="stack-item__title">{s.title}</h2>
            <TagList tags={s.tags} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section note-section" style="background: var(--color-light);">
    <div class="container note-grid">
      <div class="note reveal">
        <span class="eyebrow">On PerfectGym</span>
        <p>In the fitness sector we often integrate with PerfectGym, because it's the management software we most often find already in place. It's not a constraint: it's one of the systems we integrate with, not a requirement for working with us.</p>
      </div>
      <div class="note reveal">
        <span class="eyebrow">On AI models</span>
        <p>We use language models via API for specific tasks — we don't tie how we work to a single vendor. The model gets chosen for the task, like any other tool.</p>
      </div>
    </div>
  </section>

  <section class="section cta-block" style="background: var(--color-dark);">
    <div class="container cta-block__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">The next project</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--color-white);">Let's talk about what yours needs</h2>
      <a href={withBase('/en/contact/')} class="btn btn-primary" data-animate="fade-up">Tell us about your project</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(var(--space-16), 10vw, var(--space-20)); max-width: 800px; }
  .page-hero__title { font-family: var(--font-display); font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl)); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin-top: var(--space-4); }
  .page-hero__sub { margin-top: var(--space-6); font-size: var(--text-xl); color: var(--color-gray-mid); line-height: 1.6; max-width: 680px; }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10) var(--space-8);
  }
  .stack-item__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .note-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  .note p { margin-top: var(--space-4); font-size: var(--text-base); color: var(--color-gray-mid); line-height: 1.65; }

  .cta-block__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }

  @media (max-width: 900px) {
    .stack-grid { grid-template-columns: repeat(2, 1fr); }
    .note-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }
  @media (max-width: 560px) {
    .stack-grid { grid-template-columns: 1fr; }
  }
</style>
