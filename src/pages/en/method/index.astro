---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/url';
import { routeFor } from '../../../i18n/routes';

const steps = [
  {
    number: '01',
    title: 'Audit — Understand',
    lead: 'We observe the processes that actually happen every day. Not the theoretical ones.',
    items: ['Customer journey', 'People', 'Tools', 'Data', 'Manual steps', 'Exceptions', 'Bottlenecks'],
  },
  {
    number: '02',
    title: 'Gap Analysis — Design',
    lead: 'We measure the distance between the current process and the one you actually want.',
    items: ['What to keep', 'What to remove', 'What to integrate', 'What to automate', 'What to build'],
  },
  {
    number: '03',
    title: 'Build',
    lead: 'We build only what\'s needed.',
    items: ['Website', 'CRM', 'Application', 'Management software', 'API', 'Integration', 'Automation', 'AI agent', 'Hardware'],
  },
  {
    number: '04',
    title: 'Measure',
    lead: 'We measure the effect on the business. Not impressions. Metrics.',
    items: [],
  },
];
---

<BaseLayout
  title="Method — Ready2Digital"
  description="We first understand how the business works. Then we choose the technology. The Ready2Digital method in four stages: audit, gap analysis, build, measure."
  locale="en"
  path={routeFor('method', 'en')}
  alternatePath={routeFor('method', 'it')}
  breadcrumbs={[{ name: 'Home', path: routeFor('home', 'en') }, { name: 'Method', path: routeFor('method', 'en') }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-animate="fade-up">Method</span>
      <h1 class="page-hero__title" data-animate="clip-up">We first understand how the business works.<br>Then we choose the technology.</h1>
      <p class="page-hero__sub" data-animate="fade-up">
        Buying software and then bending your processes to fit it is how most
        implementations end up half-finished. We do it the other way round, and
        it's always the same path — from the biggest project to the smallest.
      </p>
    </div>
  </section>

  {steps.map((step, i) => (
    <section class="section step" style={i % 2 === 1 ? 'background: var(--color-light);' : ''}>
      <div class="container step__grid">
        <div class="step__number-col reveal">
          <span class="step__number">[{step.number}]</span>
        </div>
        <div class="step__content reveal">
          <h2 class="section-title">{step.title}</h2>
          <p class="step__lead">{step.lead}</p>
          {step.items.length > 0 && (
            <ul class="step__items">
              {step.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section cta-block" style="background: var(--ink);">
    <div class="container cta-block__inner" data-stagger="120">
      <span class="eyebrow" data-animate="fade-up">See it applied</span>
      <h2 class="section-title" data-animate="clip-up" style="color: var(--ink-text);">The method, on a real project</h2>
      <div class="cta-block__ctas" data-animate="fade-up">
        <a href={withBase('/en/work/athlon-club/')} class="btn btn-primary">The Athlon case</a>
        <a href={withBase('/en/contact/')} class="link-arrow" style="color: rgba(255,255,255,0.7);">Tell us about your project →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(var(--space-16), 10vw, var(--space-20)); max-width: 800px; }
  .page-hero__title { font-family: var(--font-display); font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl)); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin-top: var(--space-4); }
  .page-hero__sub { margin-top: var(--space-6); font-size: var(--text-xl); color: var(--color-gray-mid); line-height: 1.6; max-width: 680px; }

  .step__grid { display: grid; grid-template-columns: 140px 1fr; gap: var(--space-10); }
  .step__number { font-family: var(--font-mono); font-size: var(--text-4xl); font-weight: 500; color: var(--color-orange); }
  .step__content { max-width: 640px; }
  .step__lead { margin-top: var(--space-4); font-size: var(--text-xl); color: var(--color-charcoal); line-height: 1.5; }

  .step__items {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .step__items li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.7rem;
  }

  .cta-block__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }
  .cta-block__ctas { display: flex; gap: var(--space-8); align-items: center; flex-wrap: wrap; justify-content: center; }

  @media (max-width: 700px) {
    .step__grid { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
