---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import { withBase } from '../utils/url';
import type { Locale } from '../i18n/routes';
import '../styles/global.css';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  alternatePath?: string | null;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  locale,
  path,
  alternatePath = null,
  ogImage,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.ready2digital.it');

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ready2Digital',
  url: site.toString(),
  description:
    locale === 'it'
      ? "Ready2Digital progetta sistemi digitali su misura attorno ai processi reali delle aziende di servizi."
      : 'Ready2Digital designs custom digital systems built around the real operating processes of service businesses.',
  sameAs: [],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ready2Digital',
  url: site.toString(),
};

const breadcrumbJsonLd = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(withBase(b.path), site).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEO title={title} description={description} locale={locale} path={path} alternatePath={alternatePath} ogImage={ogImage} noindex={noindex} />

    <!-- Fonts: preconnect + stylesheet (no @import — avoids the extra DNS/parse hop
         of a CSS-level import chain before the browser even discovers the font). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    <Header locale={locale} alternatePath={alternatePath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} alternatePath={alternatePath} />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Count-up for stat numbers ---
      function countUp(el: HTMLElement) {
        const target = parseFloat(el.dataset.count || '0');
        const suffix = el.dataset.countSuffix || '';
        const prefix = el.dataset.countPrefix || '';
        const dur = 1500;
        let startTs: number | null = null;
        function step(ts: number) {
          if (startTs === null) startTs = ts;
          const p = Math.min((ts - startTs) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      // --- Reveal helpers ---
      function reveal(el: HTMLElement, delay?: number) {
        if (delay) el.style.setProperty('--reveal-delay', delay + 'ms');
        el.classList.add('is-visible', 'visible');
        el.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => countUp(c));
        if (el.hasAttribute('data-count')) countUp(el);
      }

      if (reduced) {
        document
          .querySelectorAll<HTMLElement>('[data-animate], .reveal, .reveal-lines, .stagger-list')
          .forEach((el) => {
            el.classList.add('is-visible', 'visible');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => {
              c.textContent =
                (c.dataset.countPrefix || '') +
                c.dataset.count +
                (c.dataset.countSuffix || '');
            });
          });
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              io.unobserve(el);

              if (el.hasAttribute('data-stagger')) {
                const step = parseInt(el.dataset.stagger || '100', 10);
                const kids = el.querySelectorAll<HTMLElement>(':scope > [data-animate], :scope > .reveal');
                kids.forEach((k, i) => reveal(k, i * step));
                el.classList.add('is-visible');
              } else {
                reveal(el, parseInt(el.dataset.delay || '0', 10));
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
        );

        const targets = new Set<HTMLElement>();
        document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((el) => targets.add(el));
        document
          .querySelectorAll<HTMLElement>('[data-animate], .reveal, .reveal-lines, .stagger-list')
          .forEach((el) => {
            if (!el.closest('[data-stagger]')) targets.add(el);
          });
        targets.forEach((el) => io.observe(el));
      }

      // --- Scroll progress bar ---
      const bar = document.getElementById('scroll-progress');
      if (bar && !reduced) {
        let ticking = false;
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? h.scrollTop / max : 0;
          bar.style.transform = 'scaleX(' + p + ')';
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 300;
    background: var(--color-dark);
    color: var(--color-white);
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .skip-link:focus {
    left: var(--space-4);
    top: var(--space-4);
  }
</style>
