---
interface Props {
  number: string;
  title: string;
  description: string;
  isLast?: boolean;
}
const { number, title, description, isLast = false } = Astro.props;
---

<div class:list={['process-step', 'reveal', { 'process-step--last': isLast }]}>
  <div class="process-step__header">
    <div class="process-step__number">{number}</div>
    {!isLast && (
      <svg class="process-step__connector process-step__connector--v" aria-hidden="true">
        <line x1="1" y1="0" x2="1" y2="100%" pathLength="1" class="process-step__connector-line" />
      </svg>
    )}
  </div>
  <div class="process-step__content">
    <h3 class="process-step__title">{title}</h3>
    <p class="process-step__desc">{description}</p>
  </div>
  {!isLast && (
    <svg class="process-step__connector process-step__connector--h" preserveAspectRatio="none" aria-hidden="true">
      <line x1="0" y1="1" x2="100%" y2="1" pathLength="1" class="process-step__connector-line" />
    </svg>
  )}
</div>

<style>
  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    position: relative;
    flex: 1;
  }

  .process-step__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Bracket numeral instead of a colored circle badge — reads like a step
     index in a spec, not a decorative UI chip. Keeps the original 56px box
     so the connector-line math below (top: 28px, left/right: calc(50% ±
     28px)) still lines up — only the fill changes. */
  .process-step__number {
    width: 56px;
    height: 56px;
    border-radius: 0;
    background: none;
    color: var(--color-orange);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .process-step__number::before { content: '['; opacity: 0.5; }
  .process-step__number::after  { content: ']'; opacity: 0.5; }

  /* The connector is a real line, not a decoration: it draws itself once,
     left to right (or top to bottom on mobile), the same moment the step
     it leads into reveals — a literal flow, not a static dashed rule. */
  .process-step__connector-line {
    stroke: var(--color-orange);
    stroke-width: 2px;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s var(--ease-out-expo);
    transition-delay: 0.15s;
  }
  .process-step.is-visible .process-step__connector-line {
    stroke-dashoffset: 0;
  }

  .process-step__connector--v {
    width: 2px;
    height: var(--space-6);
    display: none;
    overflow: visible;
  }

  .process-step__connector--h {
    display: none;
  }

  .process-step__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .process-step__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
  }

  .process-step__desc {
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
    line-height: 1.6;
    max-width: 220px;
    margin-inline: auto;
  }

  /* Horizontal connector on desktop */
  @media (min-width: 769px) {
    .process-step__connector--h {
      display: block;
      position: absolute;
      top: 28px;
      left: calc(50% + 28px);
      right: calc(-50% + 28px);
      height: 2px;
      z-index: 0;
    }
  }

  @media (max-width: 768px) {
    .process-step {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
    }
    .process-step__connector--v {
      display: block;
    }
    .process-step__number {
      margin-top: 0;
    }
    .process-step__desc {
      margin-inline: 0;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step__connector-line { transition: none; }
  }
</style>
