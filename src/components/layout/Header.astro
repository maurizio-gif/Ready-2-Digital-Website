---
import { withBase } from '../../utils/url';
import { routeFor, otherLocale, type Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  alternatePath?: string | null;
}
const { locale, alternatePath = null } = Astro.props;
const other = otherLocale(locale);
const strings = t(locale);
const switchHref = alternatePath ?? routeFor('home', other);

const nav = [
  { label: strings.nav.solutions, href: routeFor('solutions', locale) },
  { label: strings.nav.method, href: routeFor('method', locale) },
  { label: strings.nav.work, href: routeFor('work', locale) },
  { label: strings.nav.technology, href: routeFor('technology', locale) },
  { label: strings.nav.about, href: routeFor('about', locale) },
];
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href={withBase(routeFor('home', locale))} class="header__logo" aria-label="Ready2Digital">
      <img
        src={withBase('/images/logo_ready2digital.png')}
        alt="Ready2Digital"
        width="180"
        height="40"
        loading="eager"
      />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="header__links">
        {nav.map((item) => (
          <li><a href={withBase(item.href)} class="header__link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={withBase(switchHref)} class="header__lang" hreflang={other} lang={other}>
        {strings.lang.switchTo}
      </a>
      <a href={withBase(routeFor('contact', locale))} class="btn btn-primary header__cta">
        {strings.cta.primary}
      </a>
      <button class="header__hamburger" aria-label="Menu" aria-expanded="false" id="hamburger">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="header__mobile" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile">
      <ul class="header__mobile-links">
        {nav.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
        <li class="header__mobile-divider"></li>
        <li><a href={withBase(routeFor('contact', locale))}>{strings.cta.primary}</a></li>
        <li><a href={withBase(switchHref)} hreflang={other} lang={other}>{strings.lang.switchTo}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-gray-light);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 72px;
  }

  .header__logo img {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-charcoal);
    transition: color var(--transition-fast);
  }

  .header__link:hover { color: var(--color-orange); }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
  }

  .header__lang {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-gray-mid);
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.55rem;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .header__lang:hover {
    color: var(--color-orange);
    border-color: var(--color-orange);
  }

  .header__cta {
    font-size: var(--text-sm);
    padding: 0.625rem 1.25rem;
  }

  .header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    margin-left: var(--space-2);
  }

  .header__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-charcoal);
    transition: all var(--transition-base);
  }

  .header__hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .header__hamburger.open span:nth-child(2) { opacity: 0; }
  .header__hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  .header__mobile {
    display: none;
    border-top: 1px solid var(--color-gray-light);
    background: var(--color-white);
    padding: var(--space-4) var(--container-pad) var(--space-8);
  }

  .header__mobile.open { display: block; }

  .header__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .header__mobile-links a {
    display: block;
    padding: var(--space-4) var(--space-2);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-charcoal);
    min-height: 48px;
  }

  .header__mobile-divider {
    height: 1px;
    background: var(--color-gray-light);
    margin-block: var(--space-2);
  }

  @media (max-width: 900px) {
    .header__nav, .header__cta, .header__lang { display: none; }
    .header__hamburger { display: flex; }
  }
</style>

<script>
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 8);
  }, { passive: true });

  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    hamburger.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(!!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
  });
</script>
