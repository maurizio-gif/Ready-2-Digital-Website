---
// A simplified architecture diagram: a chain of labeled steps connected by
// arrows. Pure HTML/CSS, no animation library — the only motion is the
// one-time reveal every section already uses, never a continuous loop.
// Used for the homepage "problem" section and for each case study's
// Architecture section, with different steps passed in per case.
interface Step {
  label: string;
  sublabel?: string;
}
interface Props {
  steps: Step[];
  /** Visually distinguishes one step (e.g. "READY2DIGITAL") as the connector. */
  emphasizeIndex?: number;
}
const { steps, emphasizeIndex } = Astro.props;
---

<div class="pipeline" data-stagger="80">
  {steps.map((step, i) => (
    <>
      <div class:list={['pipeline__step', 'reveal', { 'pipeline__step--emphasis': i === emphasizeIndex }]}>
        <span class="pipeline__label">{step.label}</span>
        {step.sublabel && <span class="pipeline__sublabel">{step.sublabel}</span>}
      </div>
      {i < steps.length - 1 && (
        <div class="pipeline__arrow reveal" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path class="pipeline__arrow-h" d="M4 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path class="pipeline__arrow-v" d="M12 4v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      )}
    </>
  ))}
</div>

<style>
  .pipeline {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .pipeline__step {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    min-width: 0;
  }

  .pipeline__step--emphasis {
    border-color: var(--color-orange);
    background: var(--color-dark);
  }

  .pipeline__step--emphasis .pipeline__label {
    color: var(--color-white);
  }

  .pipeline__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-dark);
    letter-spacing: 0.01em;
  }

  .pipeline__sublabel {
    font-size: var(--text-xs);
    color: var(--color-gray-mid);
  }

  .pipeline__arrow {
    flex-shrink: 0;
    color: var(--color-gray-mid);
    display: flex;
  }

  .pipeline__arrow-v { display: none; }

  /* Vertical flow on narrow screens, per the brief: architectures collapse
     into a vertical list on mobile rather than staying illegible sideways. */
  @media (max-width: 640px) {
    .pipeline { flex-direction: column; align-items: stretch; }
    .pipeline__step { width: 100%; }
    .pipeline__arrow { align-self: center; }
    .pipeline__arrow-h { display: none; }
    .pipeline__arrow-v { display: block; }
  }
</style>
