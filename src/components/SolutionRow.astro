---
import { withBase } from '../utils/url';

// One line of a manifest, not a card. Avoids the icon-in-colored-circle +
// bordered-box pattern used almost everywhere for "our services" sections —
// here hierarchy comes from type scale and a hairline rule, not from boxes.
interface Props {
  index: string;
  title: string;
  description: string;
  href: string;
}
const { index, title, description, href } = Astro.props;
---

<a href={withBase(href)} class="solution-row reveal">
  <span class="solution-row__index" aria-hidden="true">{index}</span>
  <span class="solution-row__title">{title}</span>
  <span class="solution-row__desc">{description}</span>
  <span class="solution-row__arrow" aria-hidden="true">→</span>
</a>

<style>
  .solution-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.4fr) 2rem;
    align-items: baseline;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-gray-light);
    color: inherit;
    text-decoration: none;
  }

  .solution-row:last-child {
    border-bottom: 1px solid var(--color-gray-light);
  }

  .solution-row__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-gray-mid);
  }

  .solution-row__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-dark);
    letter-spacing: -0.01em;
    transition: color var(--transition-fast);
  }

  .solution-row__desc {
    font-size: var(--text-base);
    color: var(--color-gray-mid);
    line-height: 1.55;
  }

  .solution-row__arrow {
    justify-self: end;
    color: var(--color-orange);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .solution-row:hover .solution-row__title { color: var(--color-orange); }
  .solution-row:hover .solution-row__arrow { opacity: 1; transform: translateX(0); }
  .solution-row:focus-visible .solution-row__arrow { opacity: 1; transform: translateX(0); }

  @media (max-width: 768px) {
    .solution-row {
      grid-template-columns: 2.25rem 1fr;
      grid-template-areas:
        'index title'
        '.     desc';
      row-gap: var(--space-2);
    }
    .solution-row__index { grid-area: index; }
    .solution-row__title { grid-area: title; }
    .solution-row__desc { grid-area: desc; }
    .solution-row__arrow { display: none; }
  }
</style>
