---
// A small, literal 3D visual for the "build vs. buy" section: three cards
// in real CSS 3D space (perspective + rotateX/rotateY/translateZ), one per
// layer of the approach — back to front, exactly the order the text next
// to it describes. No WebGL, no gradients, no glow: flat cards with the
// same border/shadow language as the rest of the design system. It plays
// once on scroll-into-view via the site's existing `.reveal` mechanism
// (BaseLayout's IntersectionObserver) — never a continuous loop.
interface Layer {
  label: string;
}
interface Props {
  layers: Layer[];
}
const { layers } = Astro.props;
---

<div class="layers3d reveal" role="presentation">
  <div class="layers3d__scene">
    {layers.map((l) => (
      <div class="layers3d__card">
        <span class="layers3d__card-label">{l.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .layers3d {
    perspective: 1100px;
  }

  .layers3d__scene {
    position: relative;
    height: 230px;
    transform-style: preserve-3d;
  }

  .layers3d__card {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-gray-light);
    border-radius: var(--radius-md);
    background: var(--color-white);
    opacity: 0;
    transform: translateZ(0) scale(0.94);
    transition: transform 0.9s var(--ease-out-expo), opacity 0.9s var(--ease-out-expo);
  }

  .layers3d__card-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-gray-mid);
  }

  /* Back to front, fanned like a deck of cards: same order the text list
     next to it names them. rotateY only (no rotateX) so every card's
     label stays fully legible — just tilted, never edge-on. */
  .layers3d.is-visible .layers3d__card:nth-child(1) {
    opacity: 0.5;
    transform: translateX(-72px) translateY(14px) translateZ(-70px) rotateY(20deg);
  }
  .layers3d.is-visible .layers3d__card:nth-child(2) {
    opacity: 0.8;
    transform: translateX(-34px) translateY(6px) translateZ(-28px) rotateY(12deg);
    transition-delay: 0.1s;
  }
  .layers3d.is-visible .layers3d__card:nth-child(3) {
    opacity: 1;
    transform: translateZ(16px) rotateY(0deg);
    transition-delay: 0.2s;
    border-color: var(--color-orange);
  }
  .layers3d.is-visible .layers3d__card:nth-child(3) .layers3d__card-label {
    color: var(--color-dark);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .layers3d__card { transition: none !important; }
  }

  @media (max-width: 640px) {
    .layers3d__scene { height: 190px; }
  }
</style>
